APP_NAME="Math MetaVerse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
MATHVERSE_COMMIT=
HEALTH_SUPABASE_WARNING_MS=800
HEALTH_SUPABASE_CRITICAL_MS=2500
HEALTH_SCHEDULER_WARNING_SECONDS=180
HEALTH_SCHEDULER_CRITICAL_SECONDS=600
HEALTH_AUDIT_PENDING_CRITICAL_SECONDS=120
# Production defaults to APP_URL's host. Add comma-separated exact hosts only
# when the application intentionally answers on more than one hostname.
TRUSTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=deferred

CACHE_STORE=file
CACHE_LIMITER=file
# Use shared Redis for cache, rate limits, and scheduler locks across replicas.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Supabase Auth sends confirmation/recovery/security emails. MathVerse event
# emails use Laravel Mail; in production, set this to smtp and reuse the same
# custom SMTP provider credentials configured in Supabase Auth.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="notifications@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_CONNECT_TIMEOUT=5
SUPABASE_REQUEST_TIMEOUT=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Standard browser push. The function URL is optional and defaults to
# {SUPABASE_URL}/functions/v1/send-admin-push. ADMIN_PUSH_SECRET is one random
# server-to-server secret stored with the same value in Supabase Functions.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_FUNCTION_URL=
ADMIN_PUSH_SECRET=
# Browser-generated endpoints only. Add a provider host here before supporting it.
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com,*.notify.windows.com

# Incident emails use the real MAIL_* transport; no Laravel worker is needed.
# Match the private token in your independent monitor/GitHub Actions secrets.
INCIDENT_ALERTS_ENABLED=true
INCIDENT_MONITOR_TOKEN=
# Optional independent HTTPS alert destination (Slack/Discord/generic JSON).
INCIDENT_WEBHOOK_URL=
INCIDENT_WINDOW_SECONDS=600
INCIDENT_ERROR_THRESHOLD=10
INCIDENT_FAILURE_THRESHOLD=12
INCIDENT_ADMIN_ACTION_THRESHOLD=6
INCIDENT_DELIVERY_FAILURE_THRESHOLD=5
INCIDENT_REPEAT_SECONDS=3600
